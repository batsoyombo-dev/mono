{
    "name": "mono",
    "private": true,
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "catalog": {
        "bullmq": "^6.3.11",
        "zod": "^4.6.5",
        "ioredis": "^6.0.0"
    },
    "scripts": {
        "dev": "turbo run dev",
        "dev:api": "turbo run dev --filter=api",
        "dev:mq-worker": "turbo run dev --filter=mq-worker",
        "build": "turbo run build",
        "start:api": "bun run --cwd apps/api start",
        "start:mq-worker": "bun run --cwd apps/mq-worker start",
        "infra:up": "docker compose up -d",
        "infra:down": "docker compose down",
        "db:generate": "turbo run db:generate",
        "db:migrate": "bun run --cwd packages/database db:migrate",
        "db:deploy": "bun run --cwd packages/database db:deploy",
        "db:studio": "bun run --cwd packages/database db:studio",
        "seed": "bun run --cwd apps/api seed",
        "check-types": "turbo run check-types",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "format": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
        "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
        "test": "bun test",
        "clean": "find . -type d \\( -name node_modules -o -name dist -o -name .turbo \\) -prune -exec rm -rf {} +"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "eslint": "^10.12.0",
        "prettier": "^3.9.9",
        "turbo": "^2.11.7",
        "typescript": "^6.0.3"
    }
}
