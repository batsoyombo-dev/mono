{
    "name": "hippocards-global",
    "devDependencies": {
        "@types/node": "^25.9.1",
        "eslint": "^10.4.1",
        "prettier": "^3.7.4",
        "turbo": "^2.9.6",
        "typescript": "^6.0.3"
    },
    "catalog": {
        "zod": "^4.3.6",
        "bullmq": "^5.77.6",
        "dotenv": "^17.4.2"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "bun@1.3.4",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "dev:mq-worker": "turbo run dev --filter='mq-worker'",
        "db:generate": "turbo run db:generate",
        "db:migrate": "turbo run db:migrate",
        "db:deploy": "turbo run db:deploy",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "format": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
        "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
        "check-types": "bun run db:generate && turbo run check-types",
        "test": "bun test"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
