        "@mono/utils": "*",
        "better-auth": "^1.7.25",
        "bullmq": "catalog:",
        "handlebars": "^4.7.10",
        "ioredis": "catalog:",
        "nodemailer": "^10.6.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*",
        "@types/nodemailer": "^8.0.2"
