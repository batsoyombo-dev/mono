{
    "name": "@mono/database",
    "version": "1.0.0",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "eslint . --fix",
        "pre-commit": "bunx lint-staged",
        "db:generate": "bunx --bun prisma generate",
        "db:migrate": "bunx --bun prisma migrate dev --name init"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "pg": "^8.21.0"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*",
        "@types/pg": "^8.20.0",
        "prisma": "^7.8.0"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": "bun run lint"
    }
}
