{
    "name": "@mono/database",
    "version": "1.0.0",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check-types": "tsc --noEmit",
        "db:generate": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres bunx --bun prisma generate",
        "db:migrate": "bunx --bun prisma migrate dev",
        "db:deploy": "bunx --bun prisma migrate deploy"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "pg": "^8.21.0"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*",
        "@types/pg": "^8.20.0",
        "prisma": "^7.8.0"
    }
}
