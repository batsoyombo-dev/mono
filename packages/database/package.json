{
    "name": "@mono/database",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check-types": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:migrate": "bun --env-file=../../.env prisma migrate dev",
        "db:deploy": "bun --env-file=../../.env prisma migrate deploy",
        "db:studio": "bun --env-file=../../.env prisma studio"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*",
        "@types/pg": "^8.23.1",
        "prisma": "^7.10.0"
    }
}
