{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(bun run verify)",
            "Bash(bun run format)",
            "Bash(bun run format:fix)",
            "Bash(bun run check-types)",
            "Bash(bun run lint)",
            "Bash(bun run lint:fix)",
            "Bash(bun run test)",
            "Bash(bun run build)",
            "Bash(bun run db:generate)",
            "Bash(bun run db:check)",
            "Bash(bun run infra:up)",
            "Bash(bun test *)",
            "Bash(bun test)",
            "Bash(bun install)",
            "Bash(bunx eslint *)",
            "Bash(bunx tsc --noEmit*)",
            "Bash(bun run queue help)",
            "Bash(bun run queue stats*)",
            "Bash(bun run queue jobs *)",
            "Bash(bun run queue job *)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(git branch --show-current)",
            "Bash(git branch -a)",
            "Bash(git branch --list*)"
        ],
        "ask": [
            "Bash(bun run test:integration)",
            "Bash(bun run db:deploy)",
            "Bash(bun test *integration*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.*.local)",
            "Read(./.env.development)",
            "Read(./.env.staging)",
            "Read(./.env.production)",
            "Read(./.env.test)",
            "Bash(cat .env)",
            "Bash(cat ./.env)",
            "Bash(cat .env.*.local)"
        ]
    }
}
