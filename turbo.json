{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "globalEnv": ["NODE_ENV"],
    "tasks": {
        "db:generate": {
            "dependsOn": ["^db:generate"],
            "cache": false
        },
        "build": {
            "dependsOn": ["^db:generate", "db:generate"],
            "outputs": ["dist/**"]
        },
        "check-types": {
            "dependsOn": ["^db:generate", "db:generate"]
        },
        "lint": {
            "dependsOn": ["^db:generate", "db:generate"]
        },
        "lint:fix": {
            "dependsOn": ["^db:generate", "db:generate"],
            "cache": false
        },
        "dev": {
            "dependsOn": ["^db:generate", "db:generate"],
            "cache": false,
            "persistent": true
        }
    }
}
