{
    "name": "scheduler",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun dist/index.js",
        "build": "bun build ./src/index.ts --outdir dist --target bun --sourcemap && mkdir -p dist/templates && cp -R ../../packages/services/src/clients/mail/templates/. dist/templates",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@mono/error-handling": "*",
        "@mono/global-config": "*",
        "@mono/logger": "*",
        "@mono/services": "*",
        "@mono/utils": "*",
        "eventemitter3": "^5.0.4",
        "node-cron": "^4.2.1",
        "dotenv": "catalog:"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*"
    }
}
