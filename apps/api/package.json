{
    "name": "api",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --env-file=../../.env --watch src/index.ts",
        "start": "bun dist/index.js",
        "build": "bun build ./src/index.ts --outdir dist --target bun --sourcemap=linked",
        "seed": "bun --env-file=../../.env src/seed.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@elysia/cors": "^1.4.3",
        "@mono/database": "*",
        "@mono/error-handling": "*",
        "@mono/global-config": "*",
        "@mono/logger": "*",
        "@mono/services": "*",
        "@sinclair/typebox": "^0.34.52",
        "better-auth": "^1.7.25",
        "elysia": "^1.4.32"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*"
    }
}
