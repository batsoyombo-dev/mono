{
    "name": "api",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --env-file=../../.env --watch src/index.ts",
        "start": "bun dist/index.js",
        "build": "bun build ./src/index.ts --outdir dist --target bun --sourcemap=linked",
        "seed": "bun --env-file=../../.env src/seed.ts",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@bull-board/api": "^9.13.1",
        "@bull-board/elysia": "^9.13.1",
        "@bull-board/ui": "^9.13.1",
        "@elysia/cors": "^1.4.3",
        "@elysia/openapi": "^1.4.17",
        "@mono/cache": "*",
        "@mono/database": "*",
        "@mono/env": "*",
        "@mono/error-handling": "*",
        "@mono/logger": "*",
        "@mono/services": "*",
        "@mono/utils": "*",
        "@sinclair/typebox": "^0.34.52",
        "better-auth": "^1.7.25",
        "elysia": "^1.4.32",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*"
    }
}
