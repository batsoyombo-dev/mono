{
    "name": "api",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "start": "bun dist/index.js",
        "build": "bun build ./src/index.ts --outdir dist --target bun --sourcemap",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@mono/services": "*",
        "@mono/global-config": "*",
        "@mono/cache": "*",
        "@mono/error-handling": "*",
        "@mono/logger": "*",
        "@mono/utils": "*",
        "dotenv": "catalog:"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*"
    }
}
