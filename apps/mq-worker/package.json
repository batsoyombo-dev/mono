{
    "name": "mq-worker",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --env-file=../../.env --watch src/index.ts --queue default",
        "start": "bun dist/index.js --queue default",
        "queue": "bun --env-file=../../.env src/cli.ts",
        "build": "bun build ./src/index.ts --outdir dist --target bun --sourcemap=linked && mkdir -p dist/templates && cp -R ../../packages/services/src/clients/mail/templates/. dist/templates",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@mono/env": "*",
        "@mono/error-handling": "*",
        "@mono/logger": "*",
        "@mono/services": "*",
        "bullmq": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@mono/eslint-config": "*",
        "@mono/typescript-config": "*"
    }
}
