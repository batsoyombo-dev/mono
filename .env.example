# Copy to .env at the repo root. Defaults match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info
# Servers should run in UTC; @mono/utils date helpers format in the process timezone.
TZ=UTC

APP_NAME=Mono
SERVER_PORT=3000
# Largest request body in bytes (413 above). Empty means 1 MiB.
MAX_REQUEST_BODY_BYTES=
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# OpenAPI docs at /openapi. Empty means on outside production.
API_DOCS=

# Host ports for docker-compose. Change them (and the URLs below) if 5432/6379/1025/8025 are taken,
# for example by a Homebrew PostgreSQL or Redis.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mono
# Optional. db:check creates and drops a temporary shadow database next to DATABASE_URL; set this
# to use an existing, disposable database instead (Prisma wipes it).
SHADOW_DATABASE_URL=
# BullMQ. Must be a Redis with maxmemory-policy noeviction.
REDIS_URL=redis://localhost:6379
# Optional separate Redis for the cache and auth rate-limit counters (may use an evicting policy).
# Empty means REDIS_URL.
CACHE_REDIS_URL=

# Generate with: openssl rand -base64 32. The placeholder is refused when NODE_ENV is staging/production.
BETTER_AUTH_SECRET=replace-with-a-secret-of-at-least-32-characters
# Comma-separated IPs/CIDRs of the proxies in front of the API (load balancer, ingress). Their
# X-Forwarded-For entries are trusted for the client IP used by auth rate limiting. Leave empty
# only when clients connect directly; behind an unlisted proxy every client shares one bucket.
TRUSTED_PROXIES=

# Comma-separated. Verified users with these emails can open /admin/queues and /api/v1/admin/*.
# demo@example.com is the seeded local user; never keep it in a deployed environment.
ADMIN_EMAILS=demo@example.com

# Worker: jobs processed in parallel per process, and an optional liveness port (GET /health).
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=
# On SIGTERM, how long active jobs get to finish before the worker exits anyway (ms).
# Keep it below the orchestrator's grace period (Kubernetes: 30s).
WORKER_SHUTDOWN_TIMEOUT_MS=25000

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=false
MAIL_FROM_NAME=Mono
MAIL_FROM_ADDRESS=no-reply@example.com

# Optional integrations: leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
AWS_REGION=
# S3-compatible endpoint (MinIO, R2). Empty means AWS. Leave the keys empty to use the
# AWS default credential chain (IAM role, ~/.aws).
AWS_ENDPOINT=
