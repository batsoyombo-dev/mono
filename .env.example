NODE_ENV=development
SERVER_PORT=3000
BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hippocards
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace-with-a-redis-password

JWT_SECRET=replace-with-a-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-secret-of-at-least-32-characters

AWS_ACCESS_KEY=replace-with-an-access-key
AWS_SECRET_KEY=replace-with-a-secret-key
AWS_BUCKET_NAME=hippocards-development
AWS_REGION=ap-southeast-1
AWS_CLOUDFRONT_URL=https://cdn.example.com
BASE_FILE_URL=https://files.example.com

GOOGLE_CLIENT_ID=replace-with-a-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
FACEBOOK_CLIENT_ID=replace-with-a-facebook-client-id
FACEBOOK_CLIENT_SECRET=replace-with-a-facebook-client-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_REGION=ap-southeast-1
MAIL_PORT=1025
MAIL_USERNAME=replace-with-a-mail-username
MAIL_PASSWORD=replace-with-a-mail-password
MAIL_ENCRYPTION=false
MAIL_FROM_NAME=Hippocards
MAIL_FROM_ADDRESS=no-reply@example.com
