# Copy to .env at the repo root. Defaults match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info

APP_NAME=Mono
SERVER_PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mono
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secret-of-at-least-32-characters

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=false
MAIL_FROM_NAME=Mono
MAIL_FROM_ADDRESS=no-reply@example.com

# Optional integrations: leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=
AWS_REGION=
